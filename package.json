{
  "name": "php2shell-repo-audit",
  "version": "0.1.1",
  "description": "php2shell (CVE-2026-109618, CVE-2026-109619) CLI and GitHub Action: sorts the PHP versions it finds in Dockerfiles, CI and composer.json by what needs the fix.",
  "type": "module",
  "bin": {
    "php2shell-repo-audit": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "fixes/fixes.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "php2shell",
    "cve-2026-109618",
    "cve-2026-109619",
    "CVE-2026-109618",
    "CVE-2026-109619",
    "php",
    "php-fpm",
    "docker",
    "dockerfile",
    "kubernetes",
    "composer",
    "setup-php",
    "github-action",
    "github-actions",
    "ci",
    "inventory",
    "security-audit",
    "laravel",
    "wordpress",
    "drupal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amsozzer1/php2shell-repo-audit.git"
  },
  "homepage": "https://github.com/Amsozzer1/php2shell-repo-audit#readme",
  "bugs": {
    "url": "https://github.com/Amsozzer1/php2shell-repo-audit/issues"
  },
  "author": "Ahmed M. Sozzer (https://amsozzer.com)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
